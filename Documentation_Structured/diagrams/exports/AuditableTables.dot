digraph G {
  rankdir=LR;
  bgcolor="white";
  nodesep=0.5; ranksep=0.75; splines=true; concentrate=false;
  graph [fontname="Helvetica", labelloc="t", label=<<b>Component View — Azure SQL Database</b><br/><font point-size="10">SOC 2 auditable tables (ADR-0001 / migration 0034): the nine key tables carrying the audit quartet created_at, created_by, updated_at, updated_by. The *_by columns hold the effective user UPN for human writes, or a svc:<name> marker for autonomous service writes.</font><br/> >, fontsize=16];
  node [margin="0.18,0.12"];
  edge [arrowsize=0.8];

  "tenants" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nTenants\n \nTenant registry, Entra tenant\nmapping, domain, site URL,\nbranding, and tenant\nconfiguration."];
  "users" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nUsers\n \nTenant-scoped user roster,\nUPN/email, profile fields, and\nmanager hierarchy."];
  "userRoles" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nUserRoles\n \nApplication roles such as HRBP,\nPayrollBP, and Support."];
  "nominations" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nNominations\n \nAward workflow records and\nlifecycle status."];
  "nominationCategories" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nNominationCategories\n \nTenant-specific award categories."];
  "emailTemplates" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nEmailTemplates\n \nTenant-editable notification email\ntemplates (subject, body,\nversion)."];
  "processedEvents" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\nProcessedEvents\n \nService Bus idempotency log and\nprocessing result table."];
  "fraudScores" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Tables]\nFraud Score Tables\n \nP2P, approver, and HRBP fraud\nscore and feature-summary tables."];
  "graphFindings" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Tables]\nGraph and Integrity\nFindings\n \nGraph pattern findings and point-\nin-time graph flag snapshots."];
  "forecastTables" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Tables]\nForecast Tables\n \nForecast run metadata and forecast\npoints."];
  "conversations" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Tables]\nAsk Conversations and\nMessages\n \nAI analytics conversation headers,\nmessages, and export metadata."];
  "payrollTokens" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\npayroll_tokens\n \nRotating OAuth credentials\n(AES-256-GCM ciphertext) per\nprovider."];
  "payrollSubmissions" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Table]\npayroll_submissions\n \nOne row per payout submission;\nbridges the provider payroll ref\nback to the nomination."];
  "auditTables" [shape=box, style="rounded,filled", fillcolor="#85bbf0", fontcolor="#000000", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Component: Tables]\nAudit and Demo Tables\n \nImpersonation audit logs and demo\nregistration requests."];
  "tenants" -> "users" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Owns"];
  "tenants" -> "nominationCategories" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Configures"];
  "tenants" -> "emailTemplates" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Configures"];
  "tenants" -> "graphFindings" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Produces"];
  "tenants" -> "forecastTables" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Produces"];
  "tenants" -> "conversations" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Owns"];
  "users" -> "nominations" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Nominates, receives, and\napproves"];
  "nominations" -> "fraudScores" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Has"];
  "nominations" -> "payrollSubmissions" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Pays through"];
  "nominations" -> "processedEvents" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Referenced by"];
  "conversations" -> "auditTables" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Audited separately from"];
}