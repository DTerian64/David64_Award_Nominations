digraph G {
  rankdir=LR;
  bgcolor="white";
  nodesep=0.5; ranksep=0.75; splines=true; concentrate=false;
  graph [fontname="Helvetica", labelloc="t", label=<<b>Container View — Award Nomination App</b><br/><font point-size="10">Container architecture for the Award Nomination App.</font><br/> >, fontsize=16];
  node [margin="0.18,0.12"];
  edge [arrowsize=0.8];

  subgraph cluster_award { label="Award Nomination App"; style="rounded,dashed"; color="#1168bd"; fontname="Helvetica"; fontsize=12;
    "frontend" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: React, TypeScript, Vite, MSAL, i18next]\nReact Frontend\n \nUser experience for nominations,\napprovals, HRBP review, analytics,\npayroll lookup, tenant theming,\nlocalization, and impersonation."];
    "api" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: FastAPI, Python, SQLAlchemy, pyodbc]\nBackend API\n \nTenant-aware API for\nauthentication, nomination\nlifecycle, analytics, admin\noperations, certificates, payroll…"];
    "integrityWorker" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Python, Azure Service Bus SDK, scikit-learn, sentence-transformers, SHAP]\nIntegrity Check Worker\n \nConsumes nomination.submitted,\nruns description checks and fraud\nscoring, and routes nominations to\nmanager approval, HRBP review, or…"];
    "auxiliaryWorker" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Python, Azure Service Bus SDK, SMTP]\nAuxiliary Worker\n \nConsumes downstream award events,\nsends notifications, handles HRBP\nalerts, payout events, payroll\noutcomes, and idempotent side…"];
    "payrollBroker" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: FastAPI, Python, provider adapters]\nPayroll Broker\n \nProvider abstraction for payroll\nlookup, OAuth/webhooks, and\napproved award payout submission."];
    "analyticsJob" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Python, Container Apps Job, pandas, scikit-learn, networkx]\nFraud Analytics Job\n \nScheduled analytics job for graph-\npattern detection, fraud model\nretraining, holiday sync, and\nforecast model generation."];
    "mcpServices" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Python, MCP]\nMCP / Analytics Export\nServices\n \nSQL and export services used by\nanalytics and investigation\nworkflows."];
    "schemaMigrationJob" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Python, Alembic, Azure Container Apps Job]\nSchema Migration Job\n \nIn-VNet Container Apps Job that\napplies Alembic migrations to\nAzure SQL as the sql-migrations\nmanaged identity (db_ddladmin)…"];
    "database" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Azure SQL]\nAzure SQL Database\n \nSystem of record for tenants,\nusers, nominations, fraud scores,\nreview state, analytics,\nconversations, event processing,…"];
    "serviceBus" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Azure Service Bus]\nAzure Service Bus\n \naward-events topic with fraud-\nprocessor, email-processor, and\npayroll-processor subscriptions."];
    "blobStorage" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: Azure Blob Storage]\nAzure Blob Storage\n \nStores fraud models, certificates,\ncertificate templates, and\nexports."];
    "openAiAdapter" [shape=box, style="rounded,filled", fillcolor="#438dd5", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Container: OpenAI SDK]\nAzure OpenAI Adapter\n \nCalls Azure OpenAI for semantic\nchecks, explanations, ask\nanalytics, and investigations."];
  }
  "employee" [shape=box, style="filled", fillcolor="#08427b", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Person]\nEmployee / Manager / HRBP\n/ Admin\n \nTenant users who submit\nnominations, approve awards,\nreview flagged items, administer\ntenants, or inspect analytics."];
  "payrollBp" [shape=box, style="filled", fillcolor="#08427b", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Person]\nPayroll BP\n \nTenant user with PayrollBP role\nwho can inspect payroll data and\nsupport payout reconciliation."];
  "platformOperator" [shape=box, style="filled", fillcolor="#08427b", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[Person]\nPlatform Operator\n \nEngineer or support operator\nresponsible for deployment,\nobservability, and incident\nresponse."];
  "payrollProviders" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nPayroll Providers\n \nGusto, Rippling, and Workday-style\nproviders for employee pay lookup\nand award payout execution."];
  "entra" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nMicrosoft Entra ID\n \nIdentity provider for user\nauthentication and admin app\nroles."];
  "frontDoor" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nAzure Front Door + WAF\n \nEdge routing, WAF, health probes,\nTLS, and CORS handling."];
  "staticWebApps" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nAzure Static Web Apps\n \nHosts the React frontend."];
  "smtp" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nSMTP / Email Provider\n \nSends workflow, HRBP, demo,\npayroll, and analytics\nnotification emails."];
  "appInsights" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nApplication Insights + Log\nAnalytics\n \nTelemetry, traces, logs,\ndashboards, KQL validation, and\noperational analytics."];
  "keyVault" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nAzure Key Vault\n \nStores SQL credentials, provider\nsecrets, webhook secrets, OpenAI\nkeys, and Application Insights\nconnection strings."];
  "containerApps" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nAzure Container Apps\n \nRuntime hosting for API, workers,\npayroll broker, and scheduled\njobs."];
  "github" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nGitHub Actions\n \nCI/CD pipeline on GitHub-hosted\nrunners, outside the VNet; drives\nthe ARM control plane only, never\nSQL."];
  "acr" [shape=box, style="rounded,filled", fillcolor="#999999", fontcolor="#ffffff", color="#33333355", penwidth=1, fontname="Helvetica", fontsize=11, label="[External System]\nAzure Container Registry\n \nStores application and schema-\nmigration images; pulled in-VNet\nover a private endpoint."];
  "database" -> "payrollProviders" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Configures payroll via"];
  "payrollProviders" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Authenticated by"];
  "payrollProviders" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Executes payouts recorded\nin"];
  "employee" -> "frontend" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Uses"];
  "payrollBp" -> "frontend" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Uses payroll lookup and\naward context"];
  "platformOperator" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Monitors and investigates"];
  "frontend" -> "entra" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Authenticates users with\nMSAL"];
  "frontend" -> "frontDoor" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Calls API through"];
  "frontend" -> "api" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Calls backend APIs"];
  "staticWebApps" -> "frontend" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Hosts"];
  "frontDoor" -> "api" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Routes API traffic to"];
  "frontDoor" -> "payrollBroker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Routes payroll OAuth and\nwebhook traffic to"];
  "api" -> "entra" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Validates JWT issuer,\naudience, and tenant"];
  "api" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads and writes tenant-\nscoped business data"];
  "api" -> "serviceBus" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Publishes award lifecycle\nevents"];
  "api" -> "blobStorage" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads/writes certificates,\nexports, and model\nmetadata"];
  "api" -> "openAiAdapter" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Uses for analytics and\nexplanations"];
  "api" -> "payrollBroker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Calls payroll lookup API"];
  "api" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits logs, metrics, and\ntraces"];
  "api" -> "keyVault" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads secrets via managed\nidentity"];
  "serviceBus" -> "integrityWorker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Delivers\nnomination.submitted"];
  "serviceBus" -> "auxiliaryWorker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Delivers downstream\nnotification and outcome\nevents"];
  "serviceBus" -> "payrollBroker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Delivers\nnomination.approved payout\nevents"];
  "integrityWorker" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads nomination context\nand writes fraud\nflags/status"];
  "integrityWorker" -> "blobStorage" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Streams tenant fraud model\nartifacts"];
  "integrityWorker" -> "openAiAdapter" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Runs semantic checks and\nexplanations"];
  "integrityWorker" -> "serviceBus" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Publishes created,\nrejected, or flagged\nrouting events"];
  "integrityWorker" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits logs and traces"];
  "auxiliaryWorker" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads templates and\nupdates workflow/payment\nstate"];
  "auxiliaryWorker" -> "smtp" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Sends notification emails"];
  "auxiliaryWorker" -> "serviceBus" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Publishes follow-up events\nwhere required"];
  "auxiliaryWorker" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits logs and traces"];
  "payrollBroker" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads provider\nconfiguration and records\npayroll submissions"];
  "payrollBroker" -> "payrollProviders" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Submits payouts, performs\nemployee lookup, and\nreceives webhooks"];
  "payrollProviders" -> "payrollBroker" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Returns provider API\nresponses and webhook\ncallbacks"];
  "payrollBroker" -> "serviceBus" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Publishes payroll.accepted\nor payroll.failed"];
  "payrollBroker" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits logs and traces"];
  "payrollBroker" -> "keyVault" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads provider secrets and\ntoken encryption key"];
  "analyticsJob" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads nominations and\nwrites graph, score, and\nforecast data"];
  "analyticsJob" -> "blobStorage" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Uploads tenant model\nartifacts"];
  "analyticsJob" -> "api" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Calls internal model\nrefresh endpoint"];
  "analyticsJob" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits job logs and metrics"];
  "mcpServices" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Reads tenant-scoped\nanalytics data"];
  "mcpServices" -> "blobStorage" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Writes export artifacts"];
  "github" -> "acr" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Builds and pushes the\nschema-migration image"];
  "github" -> "containerApps" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Runs az containerapp job\nupdate, start, and status\nover ARM"];
  "containerApps" -> "schemaMigrationJob" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Launches a job execution\ninside the VNet"];
  "acr" -> "schemaMigrationJob" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Provides the migration\nimage via private endpoint"];
  "schemaMigrationJob" -> "entra" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Obtains a managed-identity\ntoken for Azure SQL (sql-\nmigrations, db_ddladmin)"];
  "schemaMigrationJob" -> "database" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Applies alembic upgrade\nhead over the private\nendpoint"];
  "schemaMigrationJob" -> "appInsights" [color="#707070", fontcolor="#444444", fontname="Helvetica", fontsize=9, penwidth=1, label="Emits job logs and traces"];
}