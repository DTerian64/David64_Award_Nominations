# schema-migration/.env.example — copy to .env for LOCAL runs only (gitignored).
# CI and Azure use Entra tokens (DefaultAzureCredential); leave SQL_USER/PASSWORD unset there.

SQL_SERVER=david64-sql-sandbox.database.windows.net
SQL_DATABASE=AwardNominationsSandbox
AWARD_DATABASE_NAME=AwardNominationsSandbox

# Migration 0056 only: explicit synthetic-data reset approval, off by default.
# Set only during the coordinated reset; remove after migration succeeds.
# GRAPH_FINDINGS_RESET_APPROVED=true

# Local dev options (pick one):
#   1) SQL auth — set both:
# SQL_USER=your_login
# SQL_PASSWORD=your_password
#   2) Entra — leave the two above unset and `az login` first (uses your identity).

# Optional override:
# DB_DRIVER=ODBC Driver 18 for SQL Server
